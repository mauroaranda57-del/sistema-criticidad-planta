# Copiar este archivo como .env y completar con las claves propias.

# --- Proveedor de LLM y embeddings (Google AI Studio) ---
GEMINI_API_KEY=tu_clave_de_google_ai_studio
MODEL_NAME=gemini-3.5-flash-lite
EMBEDDING_MODEL=models/gemini-embedding-001

# --- Base vectorial para el RAG (Pinecone) ---
PINECONE_API_KEY=tu_clave_de_pinecone
INDEX_NAME=planta-docs
PINECONE_NAMESPACE=manuales

# --- Estado de los jobs y checkpoints del grafo (Redis) ---
REDIS_HOST=tu-host.redis.io
REDIS_PORT=12345
REDIS_PASSWORD=tu_password_de_redis

# --- Observabilidad (LangSmith) ---
LANGSMITH_API_KEY=tu_clave_de_langsmith
LANGSMITH_PROJECT=sistema-final

# --- Parametros del orquestador (opcionales) ---
MAX_PASOS=6
RECURSION_LIMIT=15
COSTO_APROBACION_USD=20000